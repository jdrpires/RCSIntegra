									"        pm.expect(jsonData[0]).to.have.property('status');",
									"        pm.expect(jsonData[0]).to.have.property('phone_number');",
									"        pm.expect(jsonData[0]).to.have.property('created_at');",
									"    }",
									"});",
									"",
									"// Log estatísticas",
									"const messages = pm.response.json();",
									"const statusCount = {};",
									"messages.forEach(msg => {",
									"    statusCount[msg.status] = (statusCount[msg.status] || 0) + 1;",
									"});",
									"console.log(`📊 Estatísticas das mensagens:`, statusCount);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/messages?limit=10",
							"host": ["{{base_url}}"],
							"path": ["api", "messages"],
							"query": [
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "Consultar Mensagem Específica",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Usar o ID da última mensagem enviada",
									"const messageId = pm.globals.get('last_message_id');",
									"if (!messageId) {",
									"    console.log('⚠️ Nenhum message_id encontrado. Execute um envio de mensagem primeiro.');",
									"    pm.globals.set('last_message_id', '1'); // Fallback para ID 1",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Message details are complete\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('status');",
									"    pm.expect(jsonData).to.have.property('phone_number');",
									"    pm.expect(jsonData).to.have.property('created_at');",
									"});",
									"",
									"// Log detalhes da mensagem",
									"const message = pm.response.json();",
									"console.log(`📱 Mensagem ID ${message.id}:`);",
									"console.log(`   Status: ${message.status}`);",
									"console.log(`   Telefone: ${message.phone_number}`);",
									"console.log(`   Criada em: ${message.created_at}`);",
									"if (message.sent_at) console.log(`   Enviada em: ${message.sent_at}`);",
									"if (message.error_message) console.log(`   ❌ Erro: ${message.error_message}`);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/messages/{{last_message_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "messages", "{{last_message_id}}"]
						}
					}
				},
				{
					"name": "Filtrar Mensagens por Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"All messages have expected status\", function () {",
									"    const jsonData = pm.response.json();",
									"    const expectedStatus = pm.request.url.query.get('status');",
									"    if (expectedStatus && jsonData.length > 0) {",
									"        jsonData.forEach(message => {",
									"            pm.expect(message.status).to.eql(expectedStatus);",
									"        });",
									"    }",
									"});",
									"",
									"console.log(`Mensagens encontradas: ${pm.response.json().length}`);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/messages?status=sent&limit=5",
